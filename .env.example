# Kroger developer credentials — https://developer.kroger.com
# Copy the values from ../fitness-app/.env.local
KROGER_CLIENT_ID=your_kroger_client_id
KROGER_CLIENT_SECRET=your_kroger_client_secret

# Optional — a refresh token from a previous OAuth run. If set, the one-time
# browser login (python auth_cli.py) is skipped entirely.
KROGER_USER_REFRESH_TOKEN=

# Home zip code, used to find the nearest store
SHOPPER_ZIP=81224

# Optional — defaults to sqlite:///shopper.db next to this file
# SHOPPER_DB_URL=sqlite:///shopper.db
